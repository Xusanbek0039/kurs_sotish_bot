# ===== Telegram =====
# @BotFather -> /newbot orqali olinadi
BOT_TOKEN=
# Adminlarning raqamli Telegram ID'lari, vergul bilan: 111111111,222222222
ADMIN_IDS=

# ===== Tezcheck (https://tezcheck.uz/api-docs) =====
TEZCHECK_API_KEY=
# Kassa KODI (POST /cash-desks javobidagi "code"), kassa ID emas
TEZCHECK_CASH_DESK_CODE=
TEZCHECK_BASE_URL=https://api.tezcheck.uz/api/merchant/v1

# ===== Ma'lumotlar bazasi =====
DATABASE_PATH=data/bot.sqlite3

# ===== Ko'rinish =====
DEFAULT_LANGUAGE=uz
# Yordam uchun Telegram username (@ bilan yoki @siz)
SUPPORT_USERNAME=
# Ixtiyoriy: haqiqiy Telegram custom emoji ID'lari (faqat raqam). Bo'sh bo'lsa oddiy emoji ishlaydi.
CUSTOM_EMOJI_COURSE=
CUSTOM_EMOJI_PAYMENT=
CUSTOM_EMOJI_SUCCESS=
# Ixtiyoriy: stiker file_id'lari (botga stiker yuborib olinadi). Bo'sh bo'lsa stiker yuborilmaydi.
STICKER_WELCOME_FILE_ID=
STICKER_SUCCESS_FILE_ID=

# ===== Ish tartibi =====
# Ochiq to'lovlarni Tezcheck API orqali tekshirish oralig'i, soniya (15-3600)
PAYMENT_CHECK_INTERVAL=60
# Kanal taklif havolasining amal qilish muddati, soat (1-168)
INVITE_LINK_TTL_HOURS=24
